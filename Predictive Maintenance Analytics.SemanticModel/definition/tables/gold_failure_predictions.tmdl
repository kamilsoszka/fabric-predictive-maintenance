table gold_failure_predictions
	lineageTag: 0ed3149e-3237-4c64-a966-04d352382af8
	sourceLineageTag: [dbo].[gold_failure_predictions]

	measure 'Total Machines' =
			
			DISTINCTCOUNT(gold_failure_predictions[machine_id])
		formatString: 0
		lineageTag: f9c88138-802b-4f29-a543-46d907153392

		changedProperty = Name

	measure 'Predicted Failures' =
			
			CALCULATE(
			    DISTINCTCOUNT(gold_failure_predictions[machine_id]),
			    gold_failure_predictions[predicted_failure_7d] = 1
			)
		formatString: 0
		lineageTag: d7ec1346-a893-4e6f-8089-e8320231c33d

		changedProperty = Name

	measure 'Average Failure Probability' =
			
			AVERAGE(gold_failure_predictions[failure_probability])
		lineageTag: 704424a9-1a84-466a-a199-6b40ea9fb7fd

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'High Risk Machines' =
			
			CALCULATE(
			    DISTINCTCOUNT(gold_failure_predictions[machine_id]),
			    gold_failure_predictions[risk_level] = "HIGH"
			)
		formatString: 0
		lineageTag: 52ae3920-7768-4d3c-b6db-d6323a587249

		changedProperty = Name

	measure 'Predicted Failure Rate' =
			
			DIVIDE(
			    [Predicted Failures],
			    [Total Machines],
			    0
			)
		lineageTag: cbf63206-38d2-4d8e-9c8d-150bc2f97164

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'High Risk Rate' =
			
			DIVIDE(
			    [High Risk Machines],
			    [Total Machines],
			    0
			)
		lineageTag: 3b846e68-6ded-4c91-bae4-0304f45e1942

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

