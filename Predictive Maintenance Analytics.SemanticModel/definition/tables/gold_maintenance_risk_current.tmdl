table gold_maintenance_risk_current
	lineageTag: 2d20a246-8684-4d73-931e-6d829b771a1c
	sourceLineageTag: [dbo].[gold_maintenance_risk_current]

	measure 'Model Alert Rate' =
			
			DIVIDE(
			    SUM(gold_maintenance_risk_current[model_alert]),
			    DISTINCTCOUNT(gold_maintenance_risk_current[machine_id]),
			    0
			)
		lineageTag: 0bb2e65d-f1f3-452c-8ea9-6d378dc4be84

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'High Risk Machines Current' = ```
			
			CALCULATE(
			    DISTINCTCOUNT(
			        gold_maintenance_risk_current[machine_id]
			    ),
			    gold_maintenance_risk_current[risk_level] = "HIGH"
			        || gold_maintenance_risk_current[risk_level] = "CRITICAL"
			)
			
			```
		formatString: 0
		lineageTag: 5ad2b8a1-c1ba-4b4b-a2a1-b3e795d2e4c3

		changedProperty = Name

	measure 'Total Machines Current' =
			
			DISTINCTCOUNT(
			    gold_maintenance_risk_current[machine_id]
			)
		formatString: 0
		lineageTag: 343d020e-94fc-4220-97c5-bb0ee4d9d27c

		changedProperty = Name

